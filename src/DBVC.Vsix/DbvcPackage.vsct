<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidDbvcPackage">

    <Groups>
      <!--
        보기(View) 메뉴 본체에 직접 건다.
        원래는 IDG_VS_WNDO_OTRWNDWS1(View > Other Windows)에 걸었는데, SSMS 21에서는 그
        "다른 창" 캐스케이드가 Visible=False다 — 하위 항목(소스 제어 탐색기, 기록 등)이
        전부 숨겨져 있어 거기에 넣으면 영원히 보이지 않는다. Visual Studio에서만 통하는
        배치였다.
        메뉴 본체(IDM_VS_MENU_VIEW)는 SSMS에도 그대로 있고, 개체 탐색기·등록된 서버·
        템플릿 탐색기 같은 SSMS 도구 창들도 여기에 직접 놓인다.
      -->
      <Group guid="guidDbvcPackageCmdSet" id="DbvcMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW"/>
      </Group>

      <!-- SQL 에디터(코드 창) 컨텍스트 메뉴. Feature 11 -->
      <Group guid="guidDbvcPackageCmdSet" id="DbvcEditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidDbvcPackageCmdSet" id="ViewChangesCommandId" priority="0x0100" type="Button">
        <Parent guid="guidDbvcPackageCmdSet" id="DbvcMenuGroup"/>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>DBVC</ButtonText>
          <MenuText>DBVC</MenuText>
          <ToolTipText>데이터베이스 스키마 변경 사항을 확인하고 커밋합니다.</ToolTipText>
        </Strings>
      </Button>

      <Button guid="guidDbvcPackageCmdSet" id="CompareWithRepositoryCommandId" priority="0x0100" type="Button">
        <Parent guid="guidDbvcPackageCmdSet" id="DbvcEditorContextGroup"/>
        <CommandFlag>DefaultInvisible</CommandFlag>
        <CommandFlag>DynamicVisibility</CommandFlag>
        <Strings>
          <ButtonText>DBVC: Compare with Repository</ButtonText>
          <MenuText>DBVC: Compare with Repository</MenuText>
          <ToolTipText>선택한 객체를 Git 저장소의 버전과 비교합니다.</ToolTipText>
        </Strings>
      </Button>
    </Buttons>

  </Commands>

  <VisibilityConstraints>
    <!-- 패키지가 로드되지 않은 상태에서도 메뉴 항목이 보이도록 하고, 클릭 시 패키지를 로드한다. -->
    <VisibilityItem guid="guidDbvcPackageCmdSet" id="ViewChangesCommandId" context="UICONTEXT_NoSolution"/>
    <VisibilityItem guid="guidDbvcPackageCmdSet" id="ViewChangesCommandId" context="UICONTEXT_SolutionExists"/>
    <VisibilityItem guid="guidDbvcPackageCmdSet" id="CompareWithRepositoryCommandId" context="UICONTEXT_NoSolution"/>
    <VisibilityItem guid="guidDbvcPackageCmdSet" id="CompareWithRepositoryCommandId" context="UICONTEXT_SolutionExists"/>
  </VisibilityConstraints>

  <Symbols>
    <GuidSymbol name="guidDbvcPackage" value="{3f2a1c40-8b16-4d1e-9a5e-2b7c6d4e9f01}" />

    <GuidSymbol name="guidDbvcPackageCmdSet" value="{5c9e7b22-1d3f-4a68-b0c4-9e7d5f2a3b14}">
      <IDSymbol name="DbvcMenuGroup" value="0x1020" />
      <IDSymbol name="DbvcEditorContextGroup" value="0x1021" />
      <IDSymbol name="ViewChangesCommandId" value="0x0100" />
      <IDSymbol name="CompareWithRepositoryCommandId" value="0x0101" />
    </GuidSymbol>
  </Symbols>

</CommandTable>
