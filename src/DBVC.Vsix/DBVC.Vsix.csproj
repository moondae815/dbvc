<!--
  속성 형식(Project Sdk="Microsoft.NET.Sdk")이 아니라 명시적 Import 형식을 쓴다.
  속성 형식은 Sdk.targets를 파일 맨 끝에 자동으로 삽입하므로, VSSDK 타깃을 그보다 먼저
  import하게 되어 $(IntermediateOutputPath) 같은 SDK 속성이 아직 비어 있는 상태로 평가된다.
  (증상: createTemplateManifests requires argument 'TemplateOutputDirectory')
-->
<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
  </ItemGroup>

  <!--
    VSIX 패키징(.vsct 컴파일, pkgdef 생성)은 Windows의 Visual Studio SDK가 필요하다.
    다른 OS에서는 C# 컴파일과 단위 테스트만 수행되도록 조건부로 참조한다.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2185">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <VSCTCompile Include="DbvcPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBVC.Core\DBVC.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <None Include="DbvcPackage.vsct" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>

  <!--
    매니페스트가 <License>LICENSE</License>를 선언하므로 그 파일이 .vsix 안에 같은 이름으로
    들어 있어야 한다. 없으면 VSSDK1310으로 패키징이 실패한다.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <CreateVsixContainer>true</CreateVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!--
      이것이 없으면 GeneratePkgDef가 패키지를 어셈블리 표시 이름으로만 등록한다
      ("Assembly"="DBVC.Vsix, Version=..."). 그러면 셸이 GAC에서 찾으려 하는데 우리 DLL은
      확장 폴더에 있으므로 해석에 실패하고, Menus.ctmenu를 읽지 못해 메뉴 명령이 하나도
      등록되지 않는다. 빌드도 설치도 성공하므로 증상이 "메뉴가 안 보인다"로만 나타난다.
      실제 기록: ActivityLog.Setup.xml — HrLoadNativeUILibrary failed with 0x800a006f,
      "파일이나 어셈블리 'DBVC.Vsix, Version=1.0.0.0'... 을(를) 로드할 수 없습니다".
      true로 두면 "CodeBase"="$PackageFolder$\DBVC.Vsix.dll" 로 등록된다.
    -->
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <!-- 개발자 기계의 실험적 인스턴스에 자동 배포하지 않는다. 산출물만 만든다. -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!--
    VSSDK.BuildTools NuGet 패키지의 build\*.targets는 환경 변수만 설정한다.
    CreateVsixContainer·GeneratePkgDef·VSCTCompile 타깃은 tools\VSSDK\Microsoft.VsSDK.targets에
    있고 자동으로 import되지 않는다. 이 Import가 없으면 빌드는 성공하는데 .vsix도 .pkgdef도
    생기지 않는다 — 실패 메시지가 없어 원인을 찾기 어려운 종류의 문제다.

    $(VSToolsPath)는 패키지의 build\Microsoft.VSSDK.BuildTools.props가 설정한다.
    반드시 Sdk.targets 뒤에 와야 한다 (위 파일 머리말 참고).
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="'$(OS)' == 'Windows_NT' AND Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!--
    System.Text.Json이 .NET Framework에서 필요로 하는 심 어셈블리들을 .vsix에 강제로 넣는다.

    VSSDK는 이것들을 "Visual Studio가 이미 제공한다"고 보고 패키지에서 빼는데, SSMS 21에는
    해당 버전이 없다. 결과는 조용한 실패였다: JSON 직렬화가 FileNotFoundException으로 죽고,
    그 예외는 "저장 실패가 접속을 막지 않도록" 삼켜져 credentials.json이 그냥 생기지 않았다.
    실제 기록: "FileNotFoundException: ... 'System.Threading.Tasks.Extensions, Version=4.2.4.0'
    ... 지정된 파일을 찾을 수 없습니다". credentials.json뿐 아니라 mappings.json을 쓰는
    경로도 같은 스택이므로 함께 죽는다.

    빌드 출력에는 이미 복사되어 있으므로 여기서는 .vsix 목록에만 다시 얹는다. 목록을
    자동으로 계산하지 않고 이름을 적는 이유는, 출력 폴더 전체를 넣으면 DBVC.Core가 일부러
    제외한 비Windows 네이티브 바이너리까지 되돌아오기 때문이다.
  -->
  <Target Name="IncludeNetFxJsonShimsInVsix" AfterTargets="GetVsixSourceItems"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <NetFxJsonShim Include="$(OutDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <NetFxJsonShim Include="$(OutDir)System.Buffers.dll" />
      <NetFxJsonShim Include="$(OutDir)System.Memory.dll" />
      <NetFxJsonShim Include="$(OutDir)System.Numerics.Vectors.dll" />
      <NetFxJsonShim Include="$(OutDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <NetFxJsonShim Include="$(OutDir)System.Threading.Tasks.Extensions.dll" />

      <VSIXSourceItem Include="@(NetFxJsonShim)" Condition="Exists('%(FullPath)')">
        <VSIXSubPath></VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>

    <!--
      경고가 아니라 오류다. 이 어셈블리가 빠진 .vsix는 빌드도 설치도 성공한 뒤
      런타임에 조용히 저장을 실패시킨다 — 그 침묵을 찾는 데 이미 한 번 오래 걸렸다.
      요구가 바뀌어 정말 필요 없어졌다면 위 목록에서 지우는 것이 맞다.
    -->
    <Error Condition="!Exists('%(NetFxJsonShim.FullPath)')"
           Text="VSIX에 넣으려던 %(NetFxJsonShim.Filename)%(NetFxJsonShim.Extension)이(가) 출력 폴더에 없습니다. 이대로 패키징하면 JSON 저장이 런타임에 조용히 실패합니다." />
  </Target>

</Project>
