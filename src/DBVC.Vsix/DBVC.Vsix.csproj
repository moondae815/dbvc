<!--
  속성 형식(Project Sdk="Microsoft.NET.Sdk")이 아니라 명시적 Import 형식을 쓴다.
  속성 형식은 Sdk.targets를 파일 맨 끝에 자동으로 삽입하므로, VSSDK 타깃을 그보다 먼저
  import하게 되어 $(IntermediateOutputPath) 같은 SDK 속성이 아직 비어 있는 상태로 평가된다.
  (증상: createTemplateManifests requires argument 'TemplateOutputDirectory')
-->
<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
  </ItemGroup>

  <!--
    VSIX 패키징(.vsct 컴파일, pkgdef 생성)은 Windows의 Visual Studio SDK가 필요하다.
    다른 OS에서는 C# 컴파일과 단위 테스트만 수행되도록 조건부로 참조한다.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.10.2185">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <VSCTCompile Include="DbvcPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBVC.Core\DBVC.Core.csproj" />
  </ItemGroup>

  <!--
    버전의 출처는 매니페스트 하나다. 여기서 읽어 어셈블리 속성으로 넣어야 화면에 뜨는 값과
    설치된 .vsix의 버전이 갈라지지 않는다.

    AssemblyVersion은 일부러 건드리지 않는다 — pkgdef가 어셈블리 표시 이름으로 패키지를
    등록하는 자리라(RegisterWithCodebase 주석 참고) 릴리스마다 흔들 이유가 없고, 바인딩만
    복잡해진다. 표시용 값은 InformationalVersion이면 충분하다.

    XmlPeek은 기본 네임스페이스를 접두사로 명시해야 매치된다. GetAssemblyVersion보다 먼저
    돌아야 GenerateAssemblyInfo가 이 값을 본다. Windows 조건을 걸지 않는 이유는 이 타깃이
    VSSDK와 무관해서다 — 다른 OS의 컴파일·테스트에서도 같은 값이 나와야 한다.
  -->
  <Target Name="ReadVersionFromVsixManifest" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/x:PackageManifest/x:Metadata/x:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="VsixManifestVersion" />
    </XmlPeek>
    <PropertyGroup>
      <InformationalVersion>$(VsixManifestVersion)</InformationalVersion>
      <FileVersion>$(VsixManifestVersion)</FileVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" />
    <None Include="DbvcPackage.vsct" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>

  <!--
    매니페스트가 <License>LICENSE</License>를 선언하므로 그 파일이 .vsix 안에 같은 이름으로
    들어 있어야 한다. 없으면 VSSDK1310으로 패키징이 실패한다.
  -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <CreateVsixContainer>true</CreateVsixContainer>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <!--
      이것이 없으면 GeneratePkgDef가 패키지를 어셈블리 표시 이름으로만 등록한다
      ("Assembly"="DBVC.Vsix, Version=..."). 그러면 셸이 GAC에서 찾으려 하는데 우리 DLL은
      확장 폴더에 있으므로 해석에 실패하고, Menus.ctmenu를 읽지 못해 메뉴 명령이 하나도
      등록되지 않는다. 빌드도 설치도 성공하므로 증상이 "메뉴가 안 보인다"로만 나타난다.
      실제 기록: ActivityLog.Setup.xml — HrLoadNativeUILibrary failed with 0x800a006f,
      "파일이나 어셈블리 'DBVC.Vsix, Version=1.0.0.0'... 을(를) 로드할 수 없습니다".
      true로 두면 "CodeBase"="$PackageFolder$\DBVC.Vsix.dll" 로 등록된다.
    -->
    <RegisterWithCodebase>true</RegisterWithCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <!-- 개발자 기계의 실험적 인스턴스에 자동 배포하지 않는다. 산출물만 만든다. -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!--
    VSSDK.BuildTools NuGet 패키지의 build\*.targets는 환경 변수만 설정한다.
    CreateVsixContainer·GeneratePkgDef·VSCTCompile 타깃은 tools\VSSDK\Microsoft.VsSDK.targets에
    있고 자동으로 import되지 않는다. 이 Import가 없으면 빌드는 성공하는데 .vsix도 .pkgdef도
    생기지 않는다 — 실패 메시지가 없어 원인을 찾기 어려운 종류의 문제다.

    $(VSToolsPath)는 패키지의 build\Microsoft.VSSDK.BuildTools.props가 설정한다.
    반드시 Sdk.targets 뒤에 와야 한다 (위 파일 머리말 참고).
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"
          Condition="'$(OS)' == 'Windows_NT' AND Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!--
    DBVC.Core가 런타임에 필요로 하는 어셈블리를 .vsix에 강제로 넣는다.

    VSSDK는 이것들을 "Visual Studio가 이미 제공한다"고 보고 패키지에서 빼는데, SSMS 21에는
    해당 버전이 없다. 결과는 조용한 실패였다: System.Text.Json이 FileNotFoundException으로
    죽고, 그 예외는 "저장 실패가 접속을 막지 않도록" 삼켜져 credentials.json이 그냥 생기지
    않았다. 실제 기록 두 건: 'System.Threading.Tasks.Extensions, Version=4.2.4.0',
    'System.IO.Pipelines, Version=10.0.0.3'. credentials.json뿐 아니라 mappings.json을 쓰는
    경로도 같은 스택이므로 함께 죽었다.

    목록은 추측이 아니라 DBVC.Core.dll의 AssemblyRef를 재귀적으로 따라간 폐포에서, 출력
    폴더에는 있는데 .vsix에는 없는 것만 골라낸 결과다. 하나씩 이름을 보태다 보면 다음
    예외를 사용자가 대신 찾아 주게 된다 — 실제로 한 번 그렇게 됐다. 참조가 바뀌면 같은
    방법으로 다시 계산해야 한다.

    DBVC.Vsix 쪽 폐포에서 빠진 것들(Microsoft.VisualStudio.*, StreamJsonRpc, Newtonsoft.Json
    등)은 일부러 넣지 않는다. 그것들은 SSMS가 실제로 제공하며 — 제공하지 않았다면 확장이
    아예 로드되지 않았을 것이다 — 우리 사본을 실으면 오히려 버전 충돌을 만든다.

    빌드 출력에는 이미 복사되어 있으므로 여기서는 .vsix 목록에만 다시 얹는다. 출력 폴더
    전체를 넣지 않는 이유가 이것이다.
  -->
  <Target Name="IncludeCoreDependenciesInVsix" AfterTargets="GetVsixSourceItems"
          Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <CoreRuntimeDependency Include="$(OutDir)Microsoft.Bcl.AsyncInterfaces.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Buffers.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Diagnostics.DiagnosticSource.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.IO.Pipelines.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Memory.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Numerics.Vectors.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Runtime.CompilerServices.Unsafe.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Security.AccessControl.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Security.Principal.Windows.dll" />
      <CoreRuntimeDependency Include="$(OutDir)System.Threading.Tasks.Extensions.dll" />

      <VSIXSourceItem Include="@(CoreRuntimeDependency)" Condition="Exists('%(FullPath)')">
        <VSIXSubPath></VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>

    <!--
      경고가 아니라 오류다. 이 어셈블리가 빠진 .vsix는 빌드도 설치도 성공한 뒤
      런타임에 조용히 저장을 실패시킨다 — 그 침묵을 찾는 데 이미 한 번 오래 걸렸다.
      요구가 바뀌어 정말 필요 없어졌다면 위 목록에서 지우는 것이 맞다.
    -->
    <Error Condition="!Exists('%(CoreRuntimeDependency.FullPath)')"
           Text="VSIX에 넣으려던 %(CoreRuntimeDependency.Filename)%(CoreRuntimeDependency.Extension)이(가) 출력 폴더에 없습니다. 이대로 패키징하면 저장이 런타임에 조용히 실패합니다." />
  </Target>

</Project>
