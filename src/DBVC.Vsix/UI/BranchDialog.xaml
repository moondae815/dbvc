<Window x:Class="DBVC.Vsix.UI.BranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DBVC 브랜치" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <!-- 새 이름 모드 -->
        <StackPanel x:Name="NewNamePanel">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="새 브랜치 이름을 입력하세요. 지금 브랜치에서 갈라져 나오며, 작업 중인 파일은 그대로 남습니다."/>
            <TextBlock Text="이름" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- 고르기 모드 -->
        <StackPanel x:Name="PickPanel" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="갈아탈 브랜치를 고르세요. 커밋되지 않은 변경이 있으면 갈아타지 않고 무엇이 남았는지 알려 줍니다."/>
            <ListBox x:Name="BranchList" Height="180" DisplayMemberPath="Display"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="확인" Width="90" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="취소" Width="90" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
