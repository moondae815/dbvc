<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Microsoft.Data.SqlClient와 Microsoft.SqlServer.SqlManagementObjects를 여기에 적지 않는다.
    DBVC.Core가 SSMS 21에 맞춰 고정한 버전(MDS 5.1.5, SMO 171.30.0)을 전이 참조로 그대로 받는다.

    여기에 직접 적으면 그쪽이 이기고, 테스트 호스트가 Core와 다른 어셈블리를 올린다.
    실제로 그랬다 — 테스트는 SMO asm 18.100을, Core는 17.100을 물고 있어서 SmoManager가
    객체를 열거하는 순간 TypeLoadException이 났다. SmoManager는 그 예외를 삼켜 null을
    돌려주고, 당시 유일한 테스트는 성공/실패 어느 쪽이든 통과하도록 쓰여 있어서
    SMO 경로가 한 번도 실행되지 않은 채 초록으로 남았다.

    SqlConnection 같은 타입은 전이 참조로 컴파일에 그대로 쓸 수 있다.
  -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DBVC.Core\DBVC.Core.csproj" />
  </ItemGroup>

</Project>
